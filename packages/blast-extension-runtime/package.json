{
  "name": "@blastlauncher/extension-runtime",
  "version": "0.0.0",
  "private": true,
  "description": "Runtime-side lifecycle framework for Blast V2 extensions",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
