{
  "name": "blast-cors-proxy",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-17",
  "workers_dev": false,
  "routes": [{ "pattern": "blast-proxy.yukai.dev", "custom_domain": true }],
  "vars": { "ALLOWED_ORIGINS": "https://blastlauncher.github.io" },
  "ratelimits": [
    { "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } },
  ],
  "observability": { "enabled": false },
  "logpush": false,
}
