{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "singleQuote": false,
  "ignorePatterns": [
    "**/coverage/**",
    "**/dist/**",
    "**/node_modules/**",
    "**/out/**",
    "**/.webpack/**",
    "**/test/fixtures/**",
    "docs/v2/compatibility/runtime-probe*.json"
  ]
}
