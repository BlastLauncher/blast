{
  "name": "@blastlauncher/workspace",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "examples/browser-demo",
    "examples/web-launcher"
  ],
  "type": "module",
  "scripts": {
    "verify": "bun scripts/verify.ts",
    "fmt": "bun scripts/fmt.ts",
    "fmt:check": "bun scripts/fmt.ts --check",
    "lint": "oxlint --deny-warnings --ignore-pattern 'compat/raycast-api/**'",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.browser.json",
    "test": "bun test",
    "blast": "node packages/cli/src/cli.ts",
    "compat:fetch": "bun scripts/compat/fetch-raycast-api.ts",
    "compat:inventory": "bun scripts/compat/generate-inventory.ts",
    "compat:report": "bun scripts/compat/generate-coverage.ts",
    "compat:enums": "bun scripts/compat/generate-enums.ts",
    "compat:stubs": "bun scripts/compat/generate-stubs.ts",
    "compat:upgrade": "bun scripts/compat/upgrade.ts",
    "compat:check": "bun scripts/compat/check.ts",
    "protocol:schema": "bun scripts/protocol/generate-schema.ts",
    "protocol:check": "bun scripts/protocol/check-schema.ts",
    "corpus:fetch": "bun scripts/corpus/fetch.ts",
    "corpus:scan": "bun scripts/corpus/scan.ts",
    "corpus:select": "bun scripts/corpus/select.ts",
    "corpus:select-deps": "bun scripts/corpus/select-deps.ts",
    "corpus:smoke": "bun scripts/corpus/smoke-run.ts",
    "corpus:smoke-deps": "bun scripts/corpus/smoke-deps-run.ts",
    "corpus:tui-smoke": "bun scripts/corpus/tui-smoke-run.ts",
    "corpus:sweep": "bun scripts/corpus/sweep-run.ts",
    "check:workflow": "bun scripts/check-workflow.ts",
    "tasks:next": "bun scripts/tasks.ts next",
    "tasks:start": "bun scripts/tasks.ts start",
    "tasks:merge": "bun scripts/tasks.ts merge",
    "tasks:land": "bun scripts/tasks.ts land",
    "tui": "bun packages/tui/src/main.tsx",
    "blast:serve": "node packages/serve/src/main.ts",
    "release:build": "bun scripts/release/build.ts",
    "release:smoke": "bun scripts/release/smoke.ts",
    "example:go": "cd examples/go-embedder && go test ./...",
    "release:bootstrap": "bun scripts/release/prerelease.ts bootstrap",
    "example:mac": "cd examples/macos-launcher && swift test",
    "example:mac:fixtures": "bun scripts/mac-fixtures.ts",
    "example:web": "node examples/web-launcher/main.ts",
    "example:browser:e2e": "bun examples/browser-runtime/e2e.ts",
    "example:browser-demo": "bun examples/browser-demo/main.ts",
    "example:browser-demo:catalog": "bun scripts/browser-catalog.ts",
    "example:browser-demo:e2e": "bun examples/browser-demo/e2e.ts",
    "example:web-embed:e2e": "bun examples/web-embed/e2e.ts",
    "site:build": "bun examples/browser-demo/site.ts",
    "site:e2e": "bun examples/browser-demo/site-e2e.ts",
    "site:smoke:browser": "bun examples/browser-demo/site-smoke-browser.ts",
    "site:sweep:browser": "bun examples/browser-demo/browser-sweep.ts"
  },
  "devDependencies": {
    "@blastlauncher/shared-deps": "workspace:*",
    "@types/bun": "1.4.3",
    "@types/node": "^24",
    "@types/semver": "7.8.0",
    "esbuild": "0.28.2",
    "oxc-parser": "0.154.0",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24.20.0"
  }
}
