{
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["esnext"],
    "types": ["node", "bun"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": false
  },
  "include": [
    "scripts",
    "packages",
    "examples/web-launcher",
    "examples/browser-demo",
    "examples/browser-runtime/e2e.ts",
    "examples/web-embed/e2e.ts"
  ],
  "exclude": [
    "node_modules",
    "**/dist",
    ".cache",
    "examples/browser-demo/client.ts",
    "examples/browser-demo/root.ts",
    "examples/browser-demo/showcase",
    "examples/browser-runtime/runtime-entry.ts",
    "packages/web/src/index.ts",
    "packages/web/src/custom-element.ts",
    "packages/web/src/default-renderer.ts",
    "packages/web/src/handlers.ts",
    "packages/web/src/sandbox.ts",
    "packages/web/src/session.ts"
  ]
}
