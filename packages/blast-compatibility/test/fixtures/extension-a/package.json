{
  "name": "fixture-a",
  "title": "Fixture A",
  "description": "Fixture extension with a rich manifest.",
  "icon": "icon.png",
  "categories": ["Productivity", "Developer Tools"],
  "dependencies": {
    "@raycast/api": "^1.71.0"
  },
  "commands": [
    { "name": "index", "title": "Index", "mode": "view" },
    { "name": "quick", "title": "Quick", "mode": "no-view" }
  ],
  "preferences": [
    { "name": "token", "title": "Token", "type": "password", "required": true },
    { "name": "city", "title": "City", "type": "textfield" }
  ]
}
