{
  "name": "@blastlauncher/extension-host-node",
  "version": "0.0.0",
  "private": true,
  "description": "Node.js child-process launcher for Blast V2 extension hosts",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "pnpm --filter '@blastlauncher/extension-host-node...' run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@blastlauncher/extension-contract": "workspace:*",
    "@blastlauncher/extension-deps": "workspace:*",
    "@blastlauncher/extension-host": "workspace:*",
    "@blastlauncher/transport-node": "workspace:*"
  },
  "devDependencies": {
    "@blastlauncher/extension-runtime": "workspace:*",
    "@blastlauncher/extension-runtime-node": "workspace:*"
  }
}
