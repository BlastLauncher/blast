  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "pnpm --filter '@blastlauncher/extension-runtime...' run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@blastlauncher/extension-contract": "workspace:*",
    "@blastlauncher/protocol": "workspace:*",
    "@blastlauncher/scene": "workspace:*",
    "@blastlauncher/session": "workspace:*",
    "@blastlauncher/transport": "workspace:*"
  }
}
