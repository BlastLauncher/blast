{
  "name": "@blastlauncher/workspace",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "verify": "bun scripts/verify.ts",
    "fmt": "oxfmt --ignore-path .gitignore --ignore-path .ignore",
    "fmt:check": "oxfmt --check --ignore-path .gitignore --ignore-path .ignore",
    "lint": "oxlint --deny-warnings --ignore-pattern 'archive/**' --ignore-pattern 'compat/raycast-api/**'",
    "typecheck": "tsc --noEmit -p .",
    "test": "bun test",
    "blast": "node packages/cli/src/cli.ts",
    "compat:fetch": "bun scripts/compat/fetch-raycast-api.ts",
    "compat:inventory": "bun scripts/compat/generate-inventory.ts",
    "compat:report": "bun scripts/compat/generate-coverage.ts",
    "compat:enums": "bun scripts/compat/generate-enums.ts",
    "compat:stubs": "bun scripts/compat/generate-stubs.ts",
    "compat:check": "bun scripts/compat/check.ts",
    "protocol:schema": "bun scripts/protocol/generate-schema.ts",
    "protocol:check": "bun scripts/protocol/check-schema.ts",
    "corpus:fetch": "bun scripts/corpus/fetch.ts",
    "corpus:scan": "bun scripts/corpus/scan.ts",
    "corpus:select": "bun scripts/corpus/select.ts",
    "corpus:select-deps": "bun scripts/corpus/select-deps.ts",
    "corpus:smoke": "bun scripts/corpus/smoke-run.ts",
    "corpus:smoke-deps": "bun scripts/corpus/smoke-deps-run.ts",
    "corpus:tui-smoke": "bun scripts/corpus/tui-smoke-run.ts",
    "check:workflow": "bun scripts/check-workflow.ts",
    "tui": "bun packages/tui/src/main.tsx",
    "blast:serve": "node packages/serve/src/main.ts",
    "release:build": "bun scripts/release/build.ts",
    "release:smoke": "bun scripts/release/smoke.ts",
    "example:go": "cd examples/go-embedder && go test ./..."
  },
  "devDependencies": {
    "@blastlauncher/shared-deps": "workspace:*",
    "@types/bun": "1.4.3",
    "@types/node": "^24",
    "@types/semver": "7.8.0",
    "oxc-parser": "0.154.0",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24.20.0"
  }
}
